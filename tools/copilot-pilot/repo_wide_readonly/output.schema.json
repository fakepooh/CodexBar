{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repo-wide readonly review v1 final assistant output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_sha",
    "head_sha",
    "summary",
    "findings",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "title",
          "path",
          "side",
          "line_start",
          "line_end",
          "trigger",
          "impact",
          "evidence",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$"
          },
          "priority": {
            "enum": [
              "P1",
              "P2"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "enum": [
              "base",
              "head"
            ]
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "const": "high"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspected_paths",
        "limitations"
      ],
      "properties": {
        "inspected_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
